NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by seed/cron jobs (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Email of the owner account you created in Supabase Auth; the seed script writes data for this user.
SEED_USER_EMAIL=you@example.com
# Optional: required only if manually invoking the protected cron API routes.
CRON_SECRET=replace-with-a-random-secret
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
